# Used by src/lib/api.ts. Set at build time (Vite); no trailing slash.
#
# Local dev: omit this or use http://localhost:3000 (same as the default).
# VITE_API_BASE_URL=http://localhost:3000
#
# Production (Netlify): set VITE_API_BASE_URL in the Netlify UI → Site
# configuration → Environment variables → Production (your Railway HTTPS URL).
#
# Local production build test: copy to .env.production.local (gitignored) and run npm run build.
# VITE_API_BASE_URL=https://money-plan-backend-production.up.railway.app
#
# E2E (Playwright): yarn test:e2e starts the Firebase Auth emulator and Vite with
# VITE_USE_FIREBASE_AUTH_EMULATOR=true. Optional overrides (emulator-only defaults
# are fine for CI; do not put production passwords here):
# E2E_EMAIL=e2e@money-plan.test
# E2E_PASSWORD=e2e-password-123
# E2E_AUTH_EMULATOR_ORIGIN=http://127.0.0.1:9099
# E2E_BASE_URL=http://127.0.0.1:1074
# Requires Java for the Auth emulator (firebase emulators:start --only auth).
